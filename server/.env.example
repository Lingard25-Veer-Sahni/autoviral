# Copy to .env and fill in.

PORT=8787
CLIENT_URL=http://localhost:5173

# Supabase project settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- AI provider (script/title/description/hashtag generation) ---
# AI_PROVIDER picks which one is used: "claude" | "kimi" | "mistral" | "openrouter".
# Leave unset to auto-pick: the Anthropic-backed AI provider if ANTHROPIC_API_KEY
# is set, else Kimi, else Mistral, else OpenRouter.
AI_PROVIDER=

# AI provider (Anthropic) — https://console.anthropic.com (best quality, what the app is tuned against)
# Already available in this environment; set explicitly if deploying elsewhere.
ANTHROPIC_API_KEY=

# Kimi / Moonshot AI — https://platform.moonshot.ai (free-tier friendly, OpenAI-compatible)
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k2.6

# Mistral — https://console.mistral.ai (has a free tier, OpenAI-compatible)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# OpenRouter — https://openrouter.ai/keys (proxies many providers; has genuinely
# free ":free"-suffixed models, no billing required at all, OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
# Optional: a SEPARATE OpenRouter API key, from a different OpenRouter
# account, used ONLY for the admin account's free-model generations. Keeps
# admin traffic fully isolated from paying users' key/rate limits. Sign up
# again at openrouter.ai with a different email to get a second free key.
# Falls back to OPENROUTER_API_KEY above if left unset.
OPENROUTER_ADMIN_API_KEY=

# --- Render engine (which pipeline actually produces the .mp4) ---
# RENDER_ENGINE picks the compositor: "stock" | "remotion" | "canvas".
#   stock    (default) real TTS narration + real Pexels stock footage, composited
#            with ffmpeg filter graphs. Battle-tested, no headless-Chromium dependency.
#   remotion same real narration + stock footage, but composited by Remotion's
#            headless-Chromium renderer for genuinely animated (spring-physics)
#            captions and a real Ken Burns pan on fallback backgrounds. First
#            render in a given environment auto-downloads a headless Chrome
#            build (~90MB, one-time). Falls back to "stock" automatically if a
#            render throws.
#   canvas   fully-synthetic branded background (no real footage) — the
#            original fallback engine, kept as a last resort.
# Leave unset (or set to "stock") unless you've confirmed "remotion" renders
# cleanly in your environment — see SETUP.md.
RENDER_ENGINE=stock

# Pexels (used for real stock-footage video compositing) --- https://www.pexels.com/api/
# Free, instant signup, generous rate limits, no credit card required.
# Without this, videos render with a branded abstract background instead of
# real filmed footage per scene (the pipeline never fails — it just degrades).
PEXELS_API_KEY=

# Pixabay (second, independent free stock-photo + stock-video source, layered
# alongside Pexels above to widen result variety) --- https://pixabay.com/api/docs/
# Free signup (just needs a Pixabay account), no credit card, 100 requests/60s.
# Get your key at https://pixabay.com/api/docs/ (shown right on that page once
# you're logged in — no separate "create app" step).
# Without this, image search and stock-footage selection just use Pexels alone.
PIXABAY_API_KEY=

# Azure Cognitive Services Speech (real neural TTS narration — noticeably less
# robotic than the macOS "say" fallback used when this isn't set) ---
# https://portal.azure.com -> "Create a resource" -> search "Speech" -> create
# a "Speech service" resource on the free "F0" pricing tier (no credit card
# charge, 500,000 characters/month free, does not expire).
# After creating it, go to the resource's "Keys and Endpoint" page for both values below.
AZURE_SPEECH_KEY=
# The Azure region you picked when creating the resource, e.g. "eastus", "westeurope".
AZURE_SPEECH_REGION=

# Backblaze B2 (S3-compatible object storage, used only for rendered video
# files) --- https://www.backblaze.com/sign-up/b2-cloud-storage-backup-archive
# Free signup, no credit card, 10GB free storage. Needed because Supabase's
# project-wide per-object size cap (unraisable without a paid plan) rejects
# the larger files produced by the longer duration presets (roughly 3-5m and
# up) -- without this set, video uploads fall back to Supabase Storage and
# will keep failing for those lengths with "exceeded the maximum allowed size".
# 1. Sign up, then Buckets -> Create a Bucket. Name it (e.g. "autoviral-videos")
#    and set visibility to "Public" (the app needs plain public URLs, same as
#    Supabase Storage today, for playback/download/YouTube+Instagram posting).
# 2. Copy the bucket's "S3 Endpoint" (looks like s3.us-west-004.backblazeb2.com).
B2_ENDPOINT=
# 3. App Keys -> Add a New Application Key. Restrict it to the bucket above,
#    allow read+write, create it, then copy BOTH values below (the
#    applicationKey is only ever shown once).
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# ElevenLabs (optional, highest-priority narration engine — genuinely the
# most natural-sounding of the three, tried before Azure Neural TTS / the
# macOS `say` fallback) --- https://elevenlabs.io/app/sign-up
# Free tier is time/character limited (resets monthly, but the account itself
# doesn't expire). ANY failure here (quota exhausted, network error, etc.) is
# caught automatically and falls back to Azure or `say` — never blocks a
# generation, so it's safe to leave this set even after the free quota runs out.
# Get your key from the "API Keys" page in your ElevenLabs account settings.
ELEVENLABS_API_KEY=
# Optional: pin a specific voice_id from your ElevenLabs "Voices" library
# (Voice Library -> pick a voice -> copy its ID). Leave blank to just use the
# first voice on the account.
ELEVENLABS_VOICE_ID=

# Voicebox (optional, self-hosted voice cloning — https://github.com/jamiepine/voicebox)
# Lets users narrate videos with their own real cloned voice instead of the
# built-in preset voice styles. NOT a hosted API — this points at your own
# instance, so there's no key. Runs either via Docker OR directly with Python
# (no Docker needed — a plain `uvicorn` process works fine). See SETUP.md 3e
# for both paths. Leave unset to disable; every other feature (preset voices,
# rendering, posting) is completely unaffected.
VOICEBOX_URL=

# --- Google (YouTube) OAuth --- https://console.cloud.google.com/
# 1. Create a project, enable "YouTube Data API v3"
# 2. Create OAuth 2.0 Client ID (type: Web application)
# 3. Add redirect URI: {PORT's public URL}/api/social/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/social/youtube/callback

# --- Meta (Instagram) OAuth --- https://developers.facebook.com/
# 1. Create a Meta App (type: Business)
# 2. Add "Instagram Graph API" product, connect an Instagram Business/Creator account
#    linked to a Facebook Page
# 3. Add redirect URI: {PORT's public URL}/api/social/instagram/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8787/api/social/instagram/callback

# Symmetric key used to encrypt stored OAuth tokens at rest (any random 32+ char string)
TOKEN_ENCRYPTION_KEY=change-this-to-a-long-random-string

# Brevo (transactional email, via generic SMTP) -- https://app.brevo.com
# Free signup, no domain ownership/DNS verification required: Brevo lets you
# verify a single SENDER EMAIL ADDRESS (even a personal Gmail address) via a
# one-click confirmation email. Works with any other SMTP provider too
# (Resend, SendGrid, Mailgun, etc.) by just swapping these values.
# 1. Sign up at brevo.com, then Senders, Domains & Dedicated IPs -> Senders ->
#    Add a Sender -> enter the email you want to send FROM -> click the
#    confirmation link Brevo emails to that address.
# 2. Settings (bottom-left) -> SMTP & API -> SMTP tab -> copy the SMTP key
#    (shown once) -- this is SMTP_PASS below, NOT your Brevo account password.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Your Brevo account login email.
SMTP_USER=
# The SMTP key generated in step 2 above (not your Brevo password).
SMTP_PASS=
# Must be the exact address verified as a Sender in step 1. Display name is free-form.
EMAIL_FROM=Autoviral <your-verified-sender@example.com>
